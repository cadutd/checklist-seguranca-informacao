# Preencha apenas com dados públicos do projeto. Nunca use service_role aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Sem configuração, a aplicação permanece em demonstração em memória.
VITE_MODO_DEMONSTRACAO=false

# Caminho do repositório no GitHub Pages; localmente pode permanecer /.
VITE_BASE_PATH=/
